# VisionInspect AI Environment Variables Configuration
# Copy this file to .env and configure for your local environment

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visioninspect_db

# Security & JWT Configuration
SECRET_KEY=generate_a_secure_random_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Factory Supervisor Registration Code (Required to create supervisor accounts)
SUPERVISOR_REGISTRATION_CODE=VISION_AI_SUPERVISOR
